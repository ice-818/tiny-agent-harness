# Required only when task_type="reasoning" uses the DashScope-compatible API.
DASHSCOPE_API_KEY=

# Redis is the primary durable store for checkpoints and tool idempotency.
TINY_AGENT_REDIS_HOST=127.0.0.1
TINY_AGENT_REDIS_PORT=6379
TINY_AGENT_REDIS_DB=0

# Used automatically when Redis is unavailable. Keep this on durable storage.
TINY_AGENT_DATA_DIR=data
